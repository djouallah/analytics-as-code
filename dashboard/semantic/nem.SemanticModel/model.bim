{
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "description": "Australia's National Electricity Market, over the Iceberg tables of the nem lakehouse, in Direct Lake: nothing is imported and no SQL endpoint is involved. Deployed by scripts/deploy_model.py, which writes the workspace and the lakehouse into the DirectLake expression.",
    "expressions": [
      {
        "name": "DirectLake",
        "kind": "m",
        "description": "The nem lakehouse in OneLake. {WS_ID} and {LH_ID} are filled in at deploy.",
        "expression": [
          "let",
          "    Source = AzureStorage.DataLake(\"https://onelake.dfs.fabric.microsoft.com/{WS_ID}/{LH_ID}\", [HierarchicalNavigation=true])",
          "in",
          "    Source"
        ]
      }
    ],
    "tables": [
      {
        "name": "dim_calendar",
        "description": "One row per day, from 2018-03-06 (where the history starts) to two years ahead.",
        "sourceLineageTag": "[mart].[dim_calendar]",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Calendar date, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year",
            "dataType": "int64",
            "description": "Calendar year.",
            "sourceColumn": "year",
            "sourceLineageTag": "year",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "int64",
            "description": "Month of the year, 1-12.",
            "sourceColumn": "month",
            "sourceLineageTag": "month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_calendar",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_calendar",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "dim_duid",
        "description": "One row per unit: the units on AEMO's registration list, the ones in the data that are not on it (retired plant, replaced DUIDs), and the WA facilities.",
        "sourceLineageTag": "[mart].[dim_duid]",
        "columns": [
          {
            "name": "DUID",
            "dataType": "string",
            "description": "AEMO's id of a dispatchable unit.",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "Region",
            "dataType": "string",
            "description": "NSW1, QLD1, SA1, TAS1, VIC1; WA1 for Western Australia, another market.",
            "sourceColumn": "Region",
            "sourceLineageTag": "Region",
            "summarizeBy": "none"
          },
          {
            "name": "State",
            "dataType": "string",
            "description": "The region's name.",
            "sourceColumn": "State",
            "sourceLineageTag": "State",
            "summarizeBy": "none"
          },
          {
            "name": "FuelSourceDescriptor",
            "dataType": "string",
            "description": "The fuel as registered; blank for the loads AEMO gives no energy source for.",
            "sourceColumn": "FuelSourceDescriptor",
            "sourceLineageTag": "FuelSourceDescriptor",
            "summarizeBy": "none"
          },
          {
            "name": "Participant",
            "dataType": "string",
            "description": "The registered participant that operates the unit.",
            "sourceColumn": "Participant",
            "sourceLineageTag": "Participant",
            "summarizeBy": "none"
          },
          {
            "name": "StationName",
            "dataType": "string",
            "description": "The power station the unit belongs to; blank for WA.",
            "sourceColumn": "StationName",
            "sourceLineageTag": "StationName",
            "summarizeBy": "none"
          },
          {
            "name": "TechnologyType",
            "dataType": "string",
            "description": "AEMO's technology descriptor; blank off the registration list.",
            "sourceColumn": "TechnologyType",
            "sourceLineageTag": "TechnologyType",
            "summarizeBy": "none"
          },
          {
            "name": "Classification",
            "dataType": "string",
            "description": "Scheduled, Semi-Scheduled (wind and solar farms that can be capped) or Non-Scheduled; blank off the registration list.",
            "sourceColumn": "Classification",
            "sourceLineageTag": "Classification",
            "summarizeBy": "none"
          },
          {
            "name": "Renewable",
            "dataType": "boolean",
            "description": "Whether the unit's fuel is renewable; the list of fuels is in dim_duid.sql.",
            "sourceColumn": "Renewable",
            "sourceLineageTag": "Renewable",
            "summarizeBy": "none"
          },
          {
            "name": "RegCapMW",
            "dataType": "double",
            "description": "Registered generating capacity, MW.",
            "sourceColumn": "RegCapMW",
            "sourceLineageTag": "RegCapMW",
            "summarizeBy": "none"
          },
          {
            "name": "MaxCapMW",
            "dataType": "double",
            "description": "Maximum generating capacity, MW.",
            "sourceColumn": "MaxCapMW",
            "sourceLineageTag": "MaxCapMW",
            "summarizeBy": "none"
          },
          {
            "name": "StorageMWh",
            "dataType": "double",
            "description": "A battery's storage, MWh.",
            "sourceColumn": "StorageMWh",
            "sourceLineageTag": "StorageMWh",
            "summarizeBy": "none"
          },
          {
            "name": "latitude",
            "dataType": "double",
            "description": "Latitude; blank when unknown.",
            "sourceColumn": "latitude",
            "sourceLineageTag": "latitude",
            "summarizeBy": "none"
          },
          {
            "name": "longitude",
            "dataType": "double",
            "description": "Longitude; blank when unknown.",
            "sourceColumn": "longitude",
            "sourceLineageTag": "longitude",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_duid",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_duid",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "fct_summary",
        "description": "Output and price per unit and 5 minutes: the daily files where they have landed, the intraday feed after them. A unit's row carries the price of its region, so no measure joins two facts. An interval at 0 MW is not stored.",
        "sourceLineageTag": "[mart].[fct_summary]",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Date of the dispatch interval, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "dataType": "int64",
            "description": "Time of day as HHMM: 1435 is 14:35. The interval ends at it.",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "DUID",
            "dataType": "string",
            "description": "The unit.",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "mw",
            "dataType": "decimal",
            "description": "MW in that 5 minutes; a battery charging is negative.",
            "sourceColumn": "mw",
            "sourceLineageTag": "mw",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "price",
            "dataType": "decimal",
            "description": "The regional reference price of the unit's region in that interval, $/MWh.",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "cutoff",
            "dataType": "dateTime",
            "description": "The newest interval in the facts when the row was written. Provenance only.",
            "sourceColumn": "cutoff",
            "sourceLineageTag": "cutoff",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd HH:mm"
          }
        ],
        "measures": [
          {
            "name": "Generation MWh",
            "formatString": "#,##0",
            "expression": "SUMX(fct_summary, MAX(fct_summary[mw], 0)) / 12",
            "description": "Energy generated. Output only: a unit that is charging (negative) generates nothing. A row is 5 minutes, so MW / 12 is MWh."
          },
          {
            "name": "Charging MWh",
            "formatString": "#,##0",
            "expression": "SUMX(fct_summary, MIN(fct_summary[mw], 0)) / 12",
            "description": "Energy the batteries took, negative."
          },
          {
            "name": "Capture price",
            "formatString": "$#,##0.00",
            "expression": "DIVIDE(SUMX(fct_summary, MAX(fct_summary[mw], 0) * fct_summary[price]), SUMX(fct_summary, MAX(fct_summary[mw], 0)))",
            "description": "The price the output earned, $/MWh: the prices of the unit's region weighted by the output."
          },
          {
            "name": "Units",
            "formatString": "#,##0",
            "expression": "DISTINCTCOUNT(fct_summary[DUID])",
            "description": "Units with output or charging in the selection."
          },
          {
            "name": "Latest update",
            "formatString": "yyyy-MM-dd HH:mm",
            "expression": "CALCULATE(MAX(fct_summary[cutoff]), REMOVEFILTERS())",
            "description": "The newest interval the table had seen at its last write, whatever is filtered."
          },
          {
            "name": "Total generation MWh",
            "formatString": "#,##0",
            "expression": "[Generation MWh] + [Rooftop MWh]",
            "description": "Units and rooftop solar together. Slice it by region or date, not by a unit's attribute: rooftop has none, so it would be added to every slice."
          },
          {
            "name": "Renewable share",
            "formatString": "0.0",
            "expression": [
              "DIVIDE(",
              "    100 * (CALCULATE([Generation MWh], dim_duid[Renewable] = TRUE()) + [Rooftop MWh]),",
              "    CALCULATE([Generation MWh], dim_duid[FuelSourceDescriptor] <> \"Grid\") + [Rooftop MWh]",
              ")"
            ],
            "description": "Renewable share of the output, %, rooftop solar included. Batteries (fuel Grid) are in neither the renewables nor the total. Slice it by region or date."
          },
          {
            "name": "Capacity factor",
            "formatString": "0.0",
            "expression": [
              "VAR hours = COUNTROWS(SUMMARIZE(fct_region, fct_region[date], fct_region[time])) / 12",
              "VAR capacity = SUMX(SUMMARIZE(fct_summary, dim_duid[DUID], dim_duid[RegCapMW]), dim_duid[RegCapMW])",
              "RETURN DIVIDE(100 * CALCULATE([Generation MWh], dim_duid[RegCapMW] > 0), capacity * hours)"
            ],
            "description": "Energy over what the registered capacity could make in the hours of the selection, %. The capacity is that of the units with output in the selection; a unit without a registered capacity is left out. The hours are counted in fct_region."
          },
          {
            "name": "Generation MW",
            "formatString": "#,##0",
            "expression": "SUMX(fct_summary, MAX(fct_summary[mw], 0))",
            "description": "Output of the units in MW at a 5-minute time: read it at one time, it is a sum over the intervals in the selection. For energy use [Generation MWh]."
          },
          {
            "name": "Total generation MW",
            "formatString": "#,##0",
            "expression": "[Generation MW] + [Rooftop MW]",
            "description": "Units and rooftop solar together, in MW at a 5-minute time; rooftop is worked out between its half hours by [Rooftop MW]. Slice it by region, date and time, not by a unit's attribute: rooftop has none."
          }
        ],
        "partitions": [
          {
            "name": "fct_summary",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_summary",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "dim_region",
        "description": "One row per region: what the units, the regional table and rooftop are all filtered by.",
        "sourceLineageTag": "[mart].[dim_region]",
        "columns": [
          {
            "name": "Region",
            "dataType": "string",
            "description": "NSW1, QLD1, SA1, TAS1, VIC1; WA1 is Western Australia, another market (units, no prices).",
            "sourceColumn": "Region",
            "sourceLineageTag": "Region",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "State",
            "dataType": "string",
            "description": "The region's name.",
            "sourceColumn": "State",
            "sourceLineageTag": "State",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_region",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_region",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "dim_time",
        "description": "The 5-minute times of a day, 288 rows: the time axis of every fact, and what a measure reads rooftop solar against between two half hours.",
        "sourceLineageTag": "[mart].[dim_time]",
        "columns": [
          {
            "name": "time",
            "dataType": "int64",
            "description": "Time of day as HHMM: 1435 is 14:35. An interval ends at it.",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "minute",
            "dataType": "int64",
            "description": "The same time as minutes since midnight, 0 to 1435.",
            "sourceColumn": "minute",
            "sourceLineageTag": "minute",
            "summarizeBy": "none"
          },
          {
            "name": "hour",
            "dataType": "int64",
            "description": "Hour of day, 0 to 23.",
            "sourceColumn": "hour",
            "sourceLineageTag": "hour",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_time",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_time",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "fct_region",
        "description": "Price, demand and net interchange per region and 5 minutes, with the region's semi-scheduled wind and solar. The intraday record where it exists (2026-08 on), the next-day record before it.",
        "sourceLineageTag": "[mart].[fct_region]",
        "columns": [
          {
            "name": "REGIONID",
            "dataType": "string",
            "description": "The region.",
            "sourceColumn": "REGIONID",
            "sourceLineageTag": "REGIONID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Date of the interval, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "dataType": "int64",
            "description": "Time of day as HHMM: 1435 is 14:35. The interval ends at it.",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "price",
            "dataType": "decimal",
            "description": "The regional reference price (AEMO's RRP), $/MWh.",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "demand",
            "dataType": "decimal",
            "description": "Operational demand, MW: rooftop solar is not in it.",
            "sourceColumn": "demand",
            "sourceLineageTag": "demand",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "net_interchange",
            "dataType": "decimal",
            "description": "MW, positive when the region exports.",
            "sourceColumn": "net_interchange",
            "sourceLineageTag": "net_interchange",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "wind_available",
            "dataType": "decimal",
            "description": "MW the region's semi-scheduled wind could make. Blank before 2026-08.",
            "sourceColumn": "wind_available",
            "sourceLineageTag": "wind_available",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "wind_curtailed",
            "dataType": "decimal",
            "description": "MW of it that was not dispatched.",
            "sourceColumn": "wind_curtailed",
            "sourceLineageTag": "wind_curtailed",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "solar_available",
            "dataType": "decimal",
            "description": "MW the region's semi-scheduled solar could make. Blank before 2026-08.",
            "sourceColumn": "solar_available",
            "sourceLineageTag": "solar_available",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "solar_curtailed",
            "dataType": "decimal",
            "description": "MW of it that was not dispatched.",
            "sourceColumn": "solar_curtailed",
            "sourceLineageTag": "solar_curtailed",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "measures": [
          {
            "name": "Average price",
            "formatString": "$#,##0.00",
            "expression": "AVERAGE(fct_region[price])",
            "description": "The plain average of the regional prices in the selection, $/MWh."
          },
          {
            "name": "Demand MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_region[demand]) / 12",
            "description": "Operational demand as energy; rooftop solar is not in it."
          },
          {
            "name": "Net interchange MW",
            "formatString": "#,##0",
            "expression": "AVERAGE(fct_region[net_interchange])",
            "description": "Average net flow out of a region, MW; positive is exporting. Read it per region."
          },
          {
            "name": "Regional wind curtailed MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_region[wind_curtailed]) / 12",
            "description": "Semi-scheduled wind not dispatched, from AEMO's regional figures (2026-08 on, up to the newest interval)."
          },
          {
            "name": "Regional wind available MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_region[wind_available]) / 12",
            "description": "What the region's semi-scheduled wind could have made."
          },
          {
            "name": "Regional solar curtailed MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_region[solar_curtailed]) / 12",
            "description": "Semi-scheduled solar not dispatched, from AEMO's regional figures (2026-08 on, up to the newest interval)."
          },
          {
            "name": "Regional solar available MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_region[solar_available]) / 12",
            "description": "What the region's semi-scheduled solar could have made."
          }
        ],
        "partitions": [
          {
            "name": "fct_region",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_region",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "fct_rooftop",
        "description": "Rooftop solar per region and half hour: AEMO's estimate, as published, with the half hour's average price. Not units: it has no DUID, and a unit filter does not reach it. A value between two half hours, or after the newest one, is the reader's to work out.",
        "sourceLineageTag": "[mart].[fct_rooftop]",
        "columns": [
          {
            "name": "REGIONID",
            "dataType": "string",
            "description": "The region.",
            "sourceColumn": "REGIONID",
            "sourceLineageTag": "REGIONID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Date of the interval, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "dataType": "int64",
            "description": "Time of day as HHMM: 1435 is 14:35. The half hour ends at it.",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "mw",
            "dataType": "decimal",
            "description": "Estimated rooftop output at the end of the half hour, MW.",
            "sourceColumn": "mw",
            "sourceLineageTag": "mw",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "price",
            "dataType": "decimal",
            "description": "The average of the region's six 5-minute prices in the half hour, $/MWh.",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          }
        ],
        "measures": [
          {
            "name": "Rooftop MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_rooftop[mw]) / 2",
            "description": "Rooftop solar energy: a row is half an hour, so MW / 2 is MWh."
          },
          {
            "name": "Rooftop capture price",
            "formatString": "$#,##0.00",
            "expression": "DIVIDE(SUMX(fct_rooftop, fct_rooftop[mw] * fct_rooftop[price]), SUM(fct_rooftop[mw]))",
            "description": "The price rooftop solar earned, $/MWh: the half-hour prices weighted by its output."
          },
          {
            "name": "Rooftop MW",
            "formatString": "#,##0",
            "expression": [
              "SUMX(",
              "    CROSSJOIN(VALUES(dim_calendar[date]), VALUES(dim_time[minute]), VALUES(dim_region[Region])),",
              "    VAR d = dim_calendar[date]",
              "    VAR m = dim_time[minute]",
              "    VAR r = dim_region[Region]",
              "    VAR step = MOD(m, 30)",
              "    VAR before = CALCULATE(SUM(fct_rooftop[mw]), dim_calendar[date] = d, dim_time[minute] = m - step, dim_region[Region] = r)",
              "    VAR after =",
              "        IF(step > 0,",
              "            IF(m - step + 30 < 1440,",
              "                CALCULATE(SUM(fct_rooftop[mw]), dim_calendar[date] = d, dim_time[minute] = m - step + 30, dim_region[Region] = r),",
              "                CALCULATE(SUM(fct_rooftop[mw]), dim_calendar[date] = d + 1, dim_time[minute] = 0, dim_region[Region] = r)))",
              "    RETURN",
              "        IF(step = 0, before,",
              "            IF(NOT ISBLANK(before) && NOT ISBLANK(after), before + (after - before) * step / 30))",
              ")"
            ],
            "description": "Rooftop solar in MW at a 5-minute time, worked out from the half-hourly estimate: on a half hour the estimate itself, between two consecutive half hours the straight line between them, and nothing across a missing half hour. Nothing of it is stored. Summed over the dates, times and regions in the selection, so read it at one time; for energy use [Rooftop MWh]. The newest value is not carried forward: that is the chart's choice."
          }
        ],
        "partitions": [
          {
            "name": "fct_rooftop",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_rooftop",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "fct_interconnector",
        "description": "Flow on each link between regions, per 5 minutes, back to 2018. Positive from the first region in the id to the second (T-V-MNSP1 > 0: Tasmania to Victoria); the limits bound it in the same sign.",
        "sourceLineageTag": "[mart].[fct_interconnector]",
        "columns": [
          {
            "name": "interconnector",
            "dataType": "string",
            "description": "AEMO's id of the link.",
            "sourceColumn": "interconnector",
            "sourceLineageTag": "interconnector",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Date of the interval, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "dataType": "int64",
            "description": "Time of day as HHMM: 1435 is 14:35. The interval ends at it.",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "mw",
            "dataType": "decimal",
            "description": "The dispatch target flow, MW.",
            "sourceColumn": "mw",
            "sourceLineageTag": "mw",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "export_limit",
            "dataType": "decimal",
            "description": "Limit in the positive direction, MW.",
            "sourceColumn": "export_limit",
            "sourceLineageTag": "export_limit",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "import_limit",
            "dataType": "decimal",
            "description": "Limit in the negative direction, MW.",
            "sourceColumn": "import_limit",
            "sourceLineageTag": "import_limit",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "measures": [
          {
            "name": "Flow MW",
            "formatString": "#,##0",
            "expression": "AVERAGE(fct_interconnector[mw])",
            "description": "Average flow on a link, MW. Read it per link."
          }
        ],
        "partitions": [
          {
            "name": "fct_interconnector",
            "mode": "directLake",
            "source": {
              "type": "entity",
