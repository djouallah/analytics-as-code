{
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "description": "Australia's National Electricity Market, over the Iceberg tables of the nem lakehouse, in Direct Lake: nothing is imported and no SQL endpoint is involved. Deployed by scripts/deploy_model.py, which writes the workspace and the lakehouse into the DirectLake expression.",
    "expressions": [
      {
        "name": "DirectLake",
        "kind": "m",
        "description": "The nem lakehouse in OneLake. {WS_ID} and {LH_ID} are filled in at deploy.",
        "expression": [
          "let",
          "    Source = AzureStorage.DataLake(\"https://onelake.dfs.fabric.microsoft.com/{WS_ID}/{LH_ID}\", [HierarchicalNavigation=true])",
          "in",
          "    Source"
        ]
      }
    ],
    "tables": [
      {
        "name": "dim_calendar",
        "description": "One row per day, from 2018-03-06 (where the history starts) to two years ahead.",
        "sourceLineageTag": "[mart].[dim_calendar]",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Calendar date, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year",
            "dataType": "int64",
            "description": "Calendar year.",
            "sourceColumn": "year",
            "sourceLineageTag": "year",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "int64",
            "description": "Month of the year, 1-12.",
            "sourceColumn": "month",
            "sourceLineageTag": "month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_calendar",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_calendar",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "dim_duid",
        "description": "One row per unit: the units on AEMO's registration list, the ones in the data that are not on it (retired plant, replaced DUIDs), and the WA facilities.",
        "sourceLineageTag": "[mart].[dim_duid]",
        "columns": [
          {
            "name": "DUID",
            "dataType": "string",
            "description": "AEMO's id of a dispatchable unit.",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "Region",
            "dataType": "string",
            "description": "NSW1, QLD1, SA1, TAS1, VIC1; WA1 for Western Australia, another market.",
            "sourceColumn": "Region",
            "sourceLineageTag": "Region",
            "summarizeBy": "none"
          },
          {
            "name": "State",
            "dataType": "string",
            "description": "The region's name.",
            "sourceColumn": "State",
            "sourceLineageTag": "State",
            "summarizeBy": "none"
          },
          {
            "name": "FuelSourceDescriptor",
            "dataType": "string",
            "description": "The fuel as registered; blank for the loads AEMO gives no energy source for.",
            "sourceColumn": "FuelSourceDescriptor",
            "sourceLineageTag": "FuelSourceDescriptor",
            "summarizeBy": "none"
          },
          {
            "name": "Participant",
            "dataType": "string",
            "description": "The registered participant that operates the unit.",
            "sourceColumn": "Participant",
            "sourceLineageTag": "Participant",
            "summarizeBy": "none"
          },
          {
            "name": "StationName",
            "dataType": "string",
            "description": "The power station the unit belongs to; blank for WA.",
            "sourceColumn": "StationName",
            "sourceLineageTag": "StationName",
            "summarizeBy": "none"
          },
          {
            "name": "TechnologyType",
            "dataType": "string",
            "description": "AEMO's technology descriptor; blank off the registration list.",
            "sourceColumn": "TechnologyType",
            "sourceLineageTag": "TechnologyType",
            "summarizeBy": "none"
          },
          {
            "name": "Classification",
            "dataType": "string",
            "description": "Scheduled, Semi-Scheduled (wind and solar farms that can be capped) or Non-Scheduled; blank off the registration list.",
            "sourceColumn": "Classification",
            "sourceLineageTag": "Classification",
            "summarizeBy": "none"
          },
          {
            "name": "Renewable",
            "dataType": "boolean",
            "description": "Whether the unit's fuel is renewable; the list of fuels is in dim_duid.sql.",
            "sourceColumn": "Renewable",
            "sourceLineageTag": "Renewable",
            "summarizeBy": "none"
          },
          {
            "name": "RegCapMW",
            "dataType": "double",
            "description": "Registered generating capacity, MW.",
            "sourceColumn": "RegCapMW",
            "sourceLineageTag": "RegCapMW",
            "summarizeBy": "none"
          },
          {
            "name": "MaxCapMW",
            "dataType": "double",
            "description": "Maximum generating capacity, MW.",
            "sourceColumn": "MaxCapMW",
            "sourceLineageTag": "MaxCapMW",
            "summarizeBy": "none"
          },
          {
            "name": "StorageMWh",
            "dataType": "double",
            "description": "A battery's storage, MWh.",
            "sourceColumn": "StorageMWh",
            "sourceLineageTag": "StorageMWh",
            "summarizeBy": "none"
          },
          {
            "name": "latitude",
            "dataType": "double",
            "description": "Latitude; blank when unknown.",
            "sourceColumn": "latitude",
            "sourceLineageTag": "latitude",
            "summarizeBy": "none"
          },
          {
            "name": "longitude",
            "dataType": "double",
            "description": "Longitude; blank when unknown.",
            "sourceColumn": "longitude",
            "sourceLineageTag": "longitude",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_duid",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_duid",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "fct_summary",
        "description": "Output and price per unit and 5 minutes: the daily files where they have landed, the intraday feed after them. A unit's row carries the price of its region, so no measure joins two facts. An interval at 0 MW is not stored.",
        "sourceLineageTag": "[mart].[fct_summary]",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Date of the dispatch interval, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "dataType": "int64",
            "description": "Time of day as HHMM: 1435 is 14:35. The interval ends at it.",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "DUID",
            "dataType": "string",
            "description": "The unit.",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "mw",
            "dataType": "decimal",
            "description": "MW in that 5 minutes; a battery charging is negative.",
            "sourceColumn": "mw",
            "sourceLineageTag": "mw",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "price",
            "dataType": "decimal",
            "description": "The regional reference price of the unit's region in that interval, $/MWh.",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "cutoff",
            "dataType": "dateTime",
            "description": "The newest interval in the facts when the row was written. Provenance only.",
            "sourceColumn": "cutoff",
            "sourceLineageTag": "cutoff",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd HH:mm"
          }
        ],
        "measures": [
          {
            "name": "Generation MWh",
            "formatString": "#,##0",
            "expression": "SUMX(fct_summary, MAX(fct_summary[mw], 0)) / 12",
            "description": "Energy generated. Output only: a unit that is charging (negative) generates nothing. A row is 5 minutes, so MW / 12 is MWh."
          },
          {
            "name": "Charging MWh",
            "formatString": "#,##0",
            "expression": "SUMX(fct_summary, MIN(fct_summary[mw], 0)) / 12",
            "description": "Energy the batteries took, negative."
          },
          {
            "name": "Renewable share",
            "formatString": "0.0",
            "expression": [
              "DIVIDE(",
              "    100 * CALCULATE([Generation MWh], dim_duid[Renewable] = TRUE()),",
              "    CALCULATE([Generation MWh], dim_duid[FuelSourceDescriptor] <> \"Grid\")",
              ")"
            ],
            "description": "Renewable share of the output, %. Batteries (fuel Grid) are in neither the renewables nor the total. Rooftop solar is not in it yet: it gets its own table."
          },
          {
            "name": "Capture price",
            "formatString": "$#,##0.00",
            "expression": "DIVIDE(SUMX(fct_summary, MAX(fct_summary[mw], 0) * fct_summary[price]), SUMX(fct_summary, MAX(fct_summary[mw], 0)))",
            "description": "The price the output earned, $/MWh: the prices of the unit's region weighted by the output."
          },
          {
            "name": "Units",
            "formatString": "#,##0",
            "expression": "DISTINCTCOUNT(fct_summary[DUID])",
            "description": "Units with output or charging in the selection."
          },
          {
            "name": "Latest update",
            "formatString": "yyyy-MM-dd HH:mm",
            "expression": "CALCULATE(MAX(fct_summary[cutoff]), REMOVEFILTERS())",
            "description": "The newest interval the table had seen at its last write, whatever is filtered."
          }
        ],
        "partitions": [
          {
            "name": "fct_summary",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_summary",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "fct_summary_to_dim_duid",
        "fromTable": "fct_summary",
        "fromColumn": "DUID",
        "toTable": "dim_duid",
        "toColumn": "DUID",
        "relyOnReferentialIntegrity": true
      },
      {
        "name": "fct_summary_to_dim_calendar",
        "fromTable": "fct_summary",
        "fromColumn": "date",
        "toTable": "dim_calendar",
        "toColumn": "date",
        "relyOnReferentialIntegrity": true
      }
    ]
  }
}
