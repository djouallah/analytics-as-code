      {
        "name": "fct_curtailment",
        "description": "Curtailment per semi-scheduled unit (wind and solar farms) and day, up to the newest whole day of the next-day files.",
        "sourceLineageTag": "[mart].[fct_curtailment]",
        "columns": [
          {
            "name": "DUID",
            "dataType": "string",
            "description": "The unit.",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "description": "Date of the interval, NEM time (AEST all year).",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "curtailed_mwh",
            "dataType": "decimal",
            "description": "What the unit could have made and was not dispatched for: sum of max(availability - target, 0) / 12.",
            "sourceColumn": "curtailed_mwh",
            "sourceLineageTag": "curtailed_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "available_mwh",
            "dataType": "decimal",
            "description": "What the unit could have made.",
            "sourceColumn": "available_mwh",
            "sourceLineageTag": "available_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "measures": [
          {
            "name": "Curtailed MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_curtailment[curtailed_mwh])",
            "description": "Energy semi-scheduled wind and solar farms could have made and were not dispatched for."
          },
          {
            "name": "Available MWh",
            "formatString": "#,##0",
            "expression": "SUM(fct_curtailment[available_mwh])",
            "description": "Energy those farms could have made."
          },
          {
            "name": "Curtailment rate",
            "formatString": "0.0",
            "expression": "DIVIDE(100 * [Curtailed MWh], [Available MWh])",
            "description": "Curtailed energy over available energy, %."
          }
        ],
        "partitions": [
