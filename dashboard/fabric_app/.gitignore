# Dependencies and build output (one node_modules here, for both apps; each app's dist/, and
# vendor/, what an app's build fetches: the Iceberg app's DuckDB-Wasm)
node_modules
dist
vendor
*.tsbuildinfo

# Rayfin, in each app's rayfin/: generated or secret-bearing files. `.env*` covers .env and
# .env.bak; .deployments.json is this machine's record of the deployed item.
**/rayfin/.env*
**/rayfin/.deployments.json
**/rayfin/.temp/

# Rayfin's generated agent context: local only
.agents/
.mcp.json
