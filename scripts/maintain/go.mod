module github.com/djouallah/analytics-as-code/maintain

go 1.26.3

// apache/iceberg-go main, pinned to a commit (b9a9bd92, 2026-11-26, after v0.8.0-rc0). The binary
// built from it, `maintain` (linux/amd64, no cgo), is committed next to this file and is what the
// Fabric notebook runs: nothing is compiled in Fabric. Move the pin and rebuild together:
//   go get github.com/apache/iceberg-go@<commit> && go mod tidy
//   GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o maintain .
